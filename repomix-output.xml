            value: optimizationRules.join("; "),
          },
        ]}
        backLabel="Back to Step 5"
        onBack={() => setCurrentStep(5)}
        continueLabel="Start a New Problem"
        onContinue={() => {
          reset();
          setCurrentStep(1);
        }}
      />
    </div>
  );
};

