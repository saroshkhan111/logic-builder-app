        const tabFileRules = document.getElementById('tab-file-rules');
        const tabAnalogy = document.getElementById('tab-analogy');

        const sectionWorkbench = document.getElementById('section-workbench');
        const sectionPipeline = document.getElementById('section-pipeline');
        const sectionPdfProblems = document.getElementById('section-pdf-problems');
        const sectionFileRules = document.getElementById('section-file-rules');
        const sectionAnalogy = document.getElementById('section-analogy');

        function setActiveTab(btn, section) {
            [tabWorkbench, tabPipeline, tabPdfProblems, tabFileRules, tabAnalogy].forEach(b => {
                b.className = "tab-btn px-4 py-2 text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition flex items-center gap-2 whitespace-nowrap";
            });
            [sectionWorkbench, sectionPipeline, sectionPdfProblems, sectionFileRules, sectionAnalogy].forEach(s => s.classList.add('hidden'));

            btn.className = "tab-btn active px-4 py-2 text-xs font-semibold rounded-lg bg-blue-600 text-white transition flex items-center gap-2 whitespace-nowrap";
            section.classList.remove('hidden');
        }

        tabWorkbench.addEventListener('click', () => setActiveTab(tabWorkbench, sectionWorkbench));
        tabPipeline.addEventListener('click', () => setActiveTab(tabPipeline, sectionPipeline));
        tabPdfProblems.addEventListener('click', () => setActiveTab(tabPdfProblems, sectionPdfProblems));
        tabFileRules.addEventListener('click', () => setActiveTab(tabFileRules, sectionFileRules));
        tabAnalogy.addEventListener('click', () => setActiveTab(tabAnalogy, sectionAnalogy));

        // Render Input Variable Controls
        function renderVariableInputs() {
            varInputsContainer.innerHTML = '';
            currentVars.forEach((v, idx) => {
                const div = document.createElement('div');
                div.className = "flex items-center gap-2 bg-slate-950 p-2 rounded border border-slate-800";
                div.innerHTML = `
                    <input type="text" value="${v.name}" onchange="updateVar(${idx}, 'name', this.value)" class="flex-1 bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs font-mono text-slate-200">
                    <span class="text-slate-500 text-xs">=</span>
                    <input type="text" value="${v.val}" onchange="updateVar(${idx}, 'val', this.value)" class="w-24 bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs font-mono text-emerald-300">
                    <button onclick="removeVar(${idx})" class="text-rose-400 hover:text-rose-300 px-1"><i class="fa-solid fa-trash-can"></i></button>
                `;
                varInputsContainer.appendChild(div);
            });
            updateAllOutputs();
        }

        window.updateVar = function(idx, field, val) {
            currentVars[idx][field] = val;
            updateAllOutputs();
        };

        window.removeVar = function(idx) {
            currentVars.splice(idx, 1);
            renderVariableInputs();
        };

        document.getElementById('btn-add-var').addEventListener('click', () => {
            currentVars.push({ name: `var_${currentVars.length + 1}`, type: "float", val: "10" });
            renderVariableInputs();
        });

        // Load Pre-defined Problem
        function loadProblemIntoWorkbench(key) {
            setActiveTab(tabWorkbench, sectionWorkbench);
            selectWbProblem.value = key;
            const prob = WORKBENCH_PROBLEMS[key];
            if (!prob) return;

            currentProblemKey = key;
            currentVars = JSON.parse(JSON.stringify(prob.vars));
            inputResultVar.value = prob.resultVar;
            inputFormula.value = prob.formula;
            inputOutputLabel.value = prob.label;
            checkFormatDecimal.checked = prob.formatDecimal;

            renderVariableInputs();
        }

        selectWbProblem.addEventListener('change', (e) => {
            if (e.target.value !== 'custom') {
                loadProblemIntoWorkbench(e.target.value);
            } else {
                // Custom problem selected
                currentProblemKey = 'custom';
                currentVars = [{ name: "number", type: "int", val: "10" }];
                inputResultVar.value = "result";
                inputFormula.value = "number * 2";
                inputOutputLabel.value = "Calculated Result is:";
                checkFormatDecimal.checked = false;
                renderVariableInputs();
            }
        });

        // Dynamic Real-time Flowchart & Line-by-Line Pseudocode Engine
        function updateAllOutputs() {
            const resVarRaw = inputResultVar.value.trim() || 'result';
            const formulaText = inputFormula.value.trim();
            const label = inputOutputLabel.value.trim();
            const formatDec = checkFormatDecimal.checked;

            // Split formula / logic lines for multi-step logic
            const processLines = formulaText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

            // 1. Generate Python Code
            let pyCode = `# Step 1: Input Data & Variables\n`;
            if (currentVars.length > 0) {
                currentVars.forEach(v => {
                    const isNum = !isNaN(v.val) && v.val.trim() !== '';
                    const formattedVal = isNum ? v.val : `"${v.val}"`;
                    pyCode += `${v.name} = ${formattedVal}\n`;
                });
            } else {
                pyCode += `# No input variables required\n`;
            }

            pyCode += `\n# Step 2: Process & Logic Calculation\n`;
            if (processLines.length === 0) {
                pyCode += `${resVarRaw} = 0\n`;
            } else {
                processLines.forEach((line, idx) => {
                    if (line.includes('=')) {
                        pyCode += `${line}\n`;
                    } else if (/^(if|else|elif)/i.test(line)) {
                        pyCode += `${line}:\n    pass\n`;
                    } else {
                        // Assignment
                        const resVarName = processLines.length === 1 ? resVarRaw : `${resVarRaw}_step${idx+1}`;
                        pyCode += `${resVarName} = ${line}\n`;
                    }
                });
            }

            pyCode += `\n# Step 3: Display Output\n`;
            const finalResVar = processLines.length > 1 ? `${resVarRaw}_step${processLines.length}` : resVarRaw;
            if (formatDec) {
                pyCode += `print(f"${label} {${finalResVar}:.2f}")`;
            } else {
                pyCode += `print("${label}", ${finalResVar})`;
            }

            wbPythonCodeOut.textContent = pyCode;

            // 2. Generate Line-by-Line Pseudocode (Real-Time Typing reaction)
            let pseudoHTML = `<li><strong class="text-blue-400">START</strong> program execution</li>`;
            
            // Input Line Pseudocode
            if (currentVars.length > 0) {
                const varNames = currentVars.map(v => `${v.name} = ${v.val}`).join(', ');
                pseudoHTML += `<li><strong>Input Phase:</strong> Initialize variables (<code class="text-purple-300">${varNames}</code>)</li>`;
            } else {
                pseudoHTML += `<li><strong>Input Phase:</strong> No inputs required</li>`;
            }

            // Algorithm / Process Lines Pseudocode (Line-by-Line sync)
            if (processLines.length === 0) {
                pseudoHTML += `<li class="text-slate-500 font-italic">Type line 1 of formula/logic above to generate step 1...</li>`;
            } else {
                processLines.forEach((line, i) => {
                    if (/^(if|check|\?)/i.test(line)) {
                        pseudoHTML += `<li><strong>Step ${i+1} (Decision Check):</strong> Evaluate condition <code class="text-amber-300">${line}</code></li>`;
                    } else {
                        pseudoHTML += `<li><strong>Step ${i+1} (Process):</strong> Compute <code class="text-emerald-300">${line}</code></li>`;
                    }
                });
            }

            // Output Line Pseudocode
            pseudoHTML += `<li><strong>Output Phase:</strong> Display result message <code class="text-purple-300">"${label}"</code> with <code class="text-emerald-300">${finalResVar}</code></li>`;
            pseudoHTML += `<li><strong class="text-blue-400">END</strong> program</li>`;

            wbPseudoList.innerHTML = pseudoHTML;

            // 3. Generate Visual Step-by-Step Flowchart
            let flowchartHTML = `
                <!-- Oval START -->
                <div class="fc-oval">[START]</div>
                <div class="text-blue-500 font-bold text-xs">&darr;</div>
            `;

            // Flowchart Node: Input (Parallelogram)
            let varListText = currentVars.map(v => `${v.name}=${v.val}`).join(', ');
            if (!varListText) varListText = "No Input";

            flowchartHTML += `
                <!-- Parallelogram INPUT -->
                <div class="fc-parallelogram">
                    <div>Input Data: ${varListText}</div>
                </div>
                <div class="text-purple-500 font-bold text-xs">&darr;</div>
            `;

            // Flowchart Process Nodes (Dynamically added line by line as user types!)
            if (processLines.length === 0) {
                flowchartHTML += `
                    <div class="border border-dashed border-slate-700 p-2 rounded text-[11px] text-slate-500 italic">
                        Waiting for logic input... (Type formula above)
                    </div>
                    <div class="text-slate-600 font-bold text-xs">&darr;</div>
                `;
            } else {
                processLines.forEach((line, idx) => {
                    // Check if line is a decision condition or a standard process
                    const isDecision = /^(if|check|\?)/i.test(line) || line.includes('==') || line.includes('>') || line.includes('<');
                    
                    if (isDecision) {
                        flowchartHTML += `
                            <!-- Diamond DECISION -->
                            <div class="fc-diamond">
                                <div>Condition:<br><strong>${line}</strong></div>
                            </div>
                            <div class="text-amber-400 font-bold text-xs">&darr; (True/False)</div>
                        `;
                    } else {
                        flowchartHTML += `
                            <!-- Rectangle PROCESS -->
                            <div class="fc-rectangle">
                                Step ${idx+1}: ${line}
                            </div>
                            <div class="text-emerald-500 font-bold text-xs">&darr;</div>
                        `;
                    }
                });
            }

            // Flowchart Node: Output (Parallelogram)
            flowchartHTML += `
                <!-- Parallelogram OUTPUT -->
                <div class="fc-parallelogram">
                    <div>Print: "${label}" + ${finalResVar}</div>
                </div>
                <div class="text-purple-500 font-bold text-xs">&darr;</div>

                <!-- Oval END -->
                <div class="fc-oval">[END]</div>
            `;

            flowchartDiagramCanvas.innerHTML = flowchartHTML;
        }

        // Live Event Listeners for Instant typing reaction
        [inputResultVar, inputFormula, inputOutputLabel].forEach(el => {
            el.addEventListener('input', updateAllOutputs);
            el.addEventListener('keyup', updateAllOutputs);
        });
        checkFormatDecimal.addEventListener('change', updateAllOutputs);

        // Code / Pseudocode Toggle
        const btnShowCode = document.getElementById('btn-show-code');
        const btnShowPseudo = document.getElementById('btn-show-pseudo');
        const wbCodeDisplayBox = document.getElementById('wb-code-display-box');
        const wbPseudoDisplayBox = document.getElementById('wb-pseudo-display-box');

        btnShowCode.addEventListener('click', () => {
            btnShowCode.className = "px-2.5 py-1 text-xs rounded bg-blue-600 text-white font-semibold";
            btnShowPseudo.className = "px-2.5 py-1 text-xs rounded bg-slate-800 text-slate-300 font-semibold hover:bg-slate-700";
            wbCodeDisplayBox.classList.remove('hidden');
            wbPseudoDisplayBox.classList.add('hidden');
        });

        btnShowPseudo.addEventListener('click', () => {
            btnShowPseudo.className = "px-2.5 py-1 text-xs rounded bg-blue-600 text-white font-semibold";
            btnShowCode.className = "px-2.5 py-1 text-xs rounded bg-slate-800 text-slate-300 font-semibold hover:bg-slate-700";
            wbPseudoDisplayBox.classList.remove('hidden');
            wbCodeDisplayBox.classList.add('hidden');
        });

        // Dry Run Console Execution
        document.getElementById('btn-run-dry-run').addEventListener('click', () => {
            const scope = {};
            currentVars.forEach(v => {
                scope[v.name] = parseFloat(v.val) || v.val;
            });

            const formula = inputFormula.value.trim();
            const resVar = inputResultVar.value.trim() || 'result';
            const label = inputOutputLabel.value.trim();

            let evaluatedResult = "N/A";
            try {
                // Safely evaluate simple mathematical expressions in JS
                let jsFormula = formula.replace(/\*\*/g, '**'); // handled natively in modern JS
                const evalFn = new Function(...Object.keys(scope), `return ${jsFormula};`);
                evaluatedResult = evalFn(...Object.values(scope));
                if (typeof evaluatedResult === 'number' && checkFormatDecimal.checked) {
                    evaluatedResult = evaluatedResult.toFixed(2);
                }
            } catch (err) {
                evaluatedResult = `Error evaluating: ${err.message}`;
            }

            let traceLog = `> Executing Dry Run & Memory Trace...\n`;
            traceLog += `> [RAM Allocation]:\n`;
            currentVars.forEach(v => {
                traceLog += `  • ${v.name} -> ${v.val}\n`;
            });
            traceLog += `> [Executing Formula]: ${resVar} = ${formula}\n`;
            traceLog += `> [Calculated Value]: ${resVar} = ${evaluatedResult}\n`;
            traceLog += `> [Terminal Output]:\n  ${label} ${evaluatedResult}`;

            wbTerminalOutput.textContent = traceLog;
        });

        // Copy Jupyter Markdown & Python Code Buttons
        document.getElementById('btn-copy-jupyter-md').addEventListener('click', () => {
            const prob = WORKBENCH_PROBLEMS[currentProblemKey];
            const mdText = prob ? prob.markdown : `# Custom Problem\n\n${wbPythonCodeOut.textContent}`;
            navigator.clipboard.writeText(mdText).then(() => {
                const orig = document.getElementById('btn-copy-jupyter-md').innerHTML;
                document.getElementById('btn-copy-jupyter-md').innerHTML = '<i class="fa-solid fa-check"></i> Copied MD!';
                setTimeout(() => { document.getElementById('btn-copy-jupyter-md').innerHTML = orig; }, 1500);
            });
        });

        document.getElementById('btn-copy-jupyter-code').addEventListener('click', () => {
            navigator.clipboard.writeText(wbPythonCodeOut.textContent).then(() => {
                const orig = document.getElementById('btn-copy-jupyter-code').innerHTML;
                document.getElementById('btn-copy-jupyter-code').innerHTML = '<i class="fa-solid fa-check"></i> Copied Code!';
                setTimeout(() => { document.getElementById('btn-copy-jupyter-code').innerHTML = orig; }, 1500);
            });
        });

        // File Naming Inspector Logic
        function auditFilename(filename) {
            if (!filename || filename.trim() === '') return '<span class="text-slate-500">Enter filename above...</span>';
            filename = filename.trim();
            const checks = [];

            const isPy = filename.endsWith('.py');
            const isIpynb = filename.endsWith('.ipynb');

            checks.push({ text: isPy ? 'Valid Python (.py)' : (isIpynb ? 'Valid Notebook (.ipynb)' : 'Missing extension (.py/.ipynb)'), pass: isPy || isIpynb });
            checks.push({ text: /\s/.test(filename) ? 'Contains spaces (Replace with _)' : 'No spaces (Good)', pass: !/\s/.test(filename) });
            checks.push({ text: /[A-Z]/.test(filename) ? 'Contains uppercase letters' : 'All lowercase (Good)', pass: !/[A-Z]/.test(filename) });
            checks.push({ text: /^\d/.test(filename) ? 'Starts with digit (Syntax Error)' : 'Does not start with digit', pass: !/^\d/.test(filename) });

            return checks.map(c => `<div class="flex items-center gap-2"><span class="${c.pass ? 'text-emerald-400' : 'text-rose-400'} font-bold">${c.pass ? '&check;' : '&cross;'}</span><span>${c.text}</span></div>`).join('');
        }

        const inputFilenameTest = document.getElementById('input-filename-test');
        const namingChecklistResults = document.getElementById('naming-checklist-results');
        inputFilenameTest.addEventListener('input', () => {
            namingChecklistResults.innerHTML = auditFilename(inputFilenameTest.value);
        });

        // Modal Controls
        const btnNamingTool = document.getElementById('btn-naming-tool');
        const modalNaming = document.getElementById('modal-naming');
        const btnCloseNamingModal = document.getElementById('btn-close-naming-modal');
        const modalFilenameInput = document.getElementById('modal-filename-input');
        const modalNamingResults = document.getElementById('modal-naming-results');

        btnNamingTool.addEventListener('click', () => modalNaming.classList.remove('hidden'));
        btnCloseNamingModal.addEventListener('click', () => modalNaming.classList.add('hidden'));
        modalFilenameInput.addEventListener('input', () => { modalNamingResults.innerHTML = auditFilename(modalFilenameInput.value); });

        const btnAiTeacher = document.getElementById('btn-ai-teacher');
        const modalAi = document.getElementById('modal-ai');
        const btnCloseAiModal = document.getElementById('btn-close-ai-modal');
        const btnAskAi = document.getElementById('btn-ask-ai');
        const aiProblemInput = document.getElementById('ai-problem-input');
        const aiResponseBox = document.getElementById('ai-response-box');

        btnAiTeacher.addEventListener('click', () => modalAi.classList.remove('hidden'));
        btnCloseAiModal.addEventListener('click', () => modalAi.classList.add('hidden'));

        btnAskAi.addEventListener('click', async () => {
            const query = aiProblemInput.value.trim();
            if (!query) return;

            aiResponseBox.classList.remove('hidden');
            aiResponseBox.innerHTML = `<div class="text-indigo-400 p-3 flex items-center gap-2"><i class="fa-solid fa-circle-notch fa-spin text-base"></i> <span class="font-medium">Your personal AI teacher is thinking... The Module 10 breakdown is on the way...</span></div>`;

            const systemPrompt = "You are 'Your Personal AI Teacher' teaching Python problem solving in simple, beginner-friendly English based on Module 10 PDF rules. Always format responses clearly into 6 PDF steps: Step 1: Problem Statement, Step 2: Requirements, Step 3: Algorithm (Pseudocode & Flowchart), Step 4: Code, Step 5: Testing, Step 6: Optimization. Use clean markdown formatting with bold headings, bullet points, and code blocks.";
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            // Helper to render Markdown cleanly into HTML
            function parseMarkdownToHTML(md) {
                if (!md) return '';
                let html = md
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
                
                // Code blocks
                html = html.replace(/```(?:python)?\n([\s\S]*?)```/g, '<pre class="bg-slate-900 text-emerald-400 p-3 rounded-lg font-mono text-xs my-2 overflow-x-auto border border-slate-800"><code>$1</code></pre>');
                // Inline code
                html = html.replace(/`([^`]+)`/g, '<code class="bg-slate-900 text-emerald-300 px-1.5 py-0.5 rounded font-mono text-[11px]">$1</code>');
                // Bold
                html = html.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-indigo-300 font-bold">$1</strong>');
                // Headings
                html = html.replace(/^### (.*$)/gim, '<h4 class="text-xs font-bold text-amber-400 mt-3 mb-1 uppercase tracking-wider">$1</h4>');
                html = html.replace(/^## (.*$)/gim, '<h3 class="text-sm font-bold text-indigo-400 mt-4 mb-2 border-b border-slate-800 pb-1">$1</h3>');
                // New lines to br
                html = html.replace(/\n/g, '<br>');
                return html;
            }

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: `Solve this problem using Module 10 steps:\n${query}` }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] }
                    })
                });

                if (!response.ok) {
                    const errData = await response.json().catch(() => ({}));
                    throw new Error(errData?.error?.message || `API Request failed with status code ${response.status}`);
                }

                const data = await response.json();
                const resultText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                
                if (resultText) {
                    aiResponseBox.innerHTML = `<div class="prose prose-invert max-w-none text-xs text-slate-200 leading-relaxed space-y-2 p-1">${parseMarkdownToHTML(resultText)}</div>`;
                } else {
                    aiResponseBox.innerHTML = `<div class="p-3 text-rose-400 font-semibold bg-rose-500/10 rounded-lg border border-rose-500/20 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation"></i> The AI did not send response text. Click 'Generate 6-Step Breakdown' again.</div>`;
                }
            } catch (err) {
                console.error("AI Teacher Error:", err);
                aiResponseBox.innerHTML = `<div class="p-3 text-rose-400 text-xs bg-rose-500/10 rounded-lg border border-rose-500/20 space-y-1"><div class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-circle-xmark text-sm"></i> Connection / Request Issue</div><div>${err.message || 'Failed to fetch solution. Please check your connection or try again.'}</div></div>`;
            }
        });

        // Initialize Application with Circle Area Problem
        loadProblemIntoWorkbench('circle');
    </script>
</body>
</html>
