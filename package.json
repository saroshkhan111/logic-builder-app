{
  "name": "logic-builder-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "py:sync": "uv sync",
    "py:test": "uv run pytest",
    "py:lint": "uv run flake8 python_engine",
    "py:format": "uv run black python_engine",
    "py:check": "uv run black --check python_engine && uv run flake8 python_engine",
    "py:checks": "uv run python -m python_engine.scripts.run_checks",
    "py:api": "uv run uvicorn python_engine.api.main:app --reload"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pyodide": "^314.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
